# WebTS settings. Copy to .env and fill in. Lines starting with # are comments.

# --- The TeamSpeak server -------------------------------------------------------------------------------------
# Its address as the WebTS container sees it (a host name, an IP, or the container name on the same Docker network).
TS_HOST=127.0.0.1
TS_PORT=9987
# Only if the server has a password:
# TS_SERVER_PASSWORD=
# The channel people land in (its name); empty = the server's default channel:
# TS_DEFAULT_CHANNEL=
# In front of every WebTS user's nickname:
NICK_PREFIX="Web - "

# --- This WebTS ---------------------------------------------------------------------------------------------------
# The address people open, e.g. https://webts.example.com. Only that site may use the voice connection.
PUBLIC_URL=
PORT=3002
# How many people can be connected at once:
MAX_USERS=50
# Your site's time zone, for the names of pictures sent from WebTS:
# TZ=Europe/Berlin

# --- Who gets in (README: "Access") -------------------------------------------------------------------------------
# cloudflare-access (recommended) | header | public | signed-note
ACCESS_MODE=cloudflare-access

# cloudflare-access: your Zero Trust team domain and the Access application's "Application Audience (AUD) Tag".
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
CF_ACCESS_AUD=

# header: behind another login proxy that puts the user name in a header. WebTS must be reachable ONLY through it.
# ACCESS_HEADER=Remote-User
# ACCESS_NAME_HEADER=Remote-Name

# public: anyone with the address can join your TeamSpeak server. Each browser gets its own identity.
# I_UNDERSTAND_THIS_IS_PUBLIC=true
# PUBLIC_MAX_IDENTITIES=500

# signed-note: your own gateway signs who the person is (README: "Your own gateway").
# ACCESS_NOTE_SECRET=
# ACCESS_NOTE_HEADER=x-webts-note

# The page's menu: a sign-out address (with cloudflare-access, Access's own is used unless set) and a link back to
# your site.
# LOGOUT_URL=
# BACK_URL=https://www.example.com
# BACK_LABEL=Back

# --- Pictures in the chat -----------------------------------------------------------------------------------------
PICTURES=true
PICTURE_MAX_MB=15
# The folder in each channel's file browser:
PICTURE_FOLDER=/webTS

# --- Chat history across days (optional, README: "Chat history") --------------------------------------------------
# Off unless on: then the chat lasts only while the page is open. When on, each person's chat is kept in DATA_DIR/chat/,
# locked with CHAT_HISTORY_KEY (required then). Make a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy of the key somewhere safe but not with your backups of the data folder; without it the history can't
# be opened again.
# CHAT_HISTORY=on
# CHAT_HISTORY_KEY=
# CHAT_HISTORY_DAYS=30
# CHAT_HISTORY_LINES=300

# --- Relay for people behind strict networks (optional, README: "Relay") ---------------------------------------
# Your own coturn server (use-auth-secret):
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=
# Or Cloudflare Realtime TURN:
# CF_TURN_KEY_ID=
# CF_TURN_KEY_TOKEN=
# ...with a monthly cap (needs an API token with Account Analytics: Read):
# CF_ACCOUNT_ID=
# CF_ANALYTICS_TOKEN=
# CF_TURN_CAP_GB=950

# --- Troubleshooting ------------------------------------------------------------------------------------------------
# STREAM_LOG=verbose
