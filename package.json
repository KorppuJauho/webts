{
  "name": "webts",
  "version": "1.1.0",
  "description": "A self-hosted web client for TeamSpeak servers: voice, chat, pictures and streams in the browser",
  "private": true,
  "license": "OSL-3.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit -p ."
