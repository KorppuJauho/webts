  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.18.2",
    "libsodium-wrappers-sumo": "^0.8.4",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "typescript": "^5.3.3"
  }
}
